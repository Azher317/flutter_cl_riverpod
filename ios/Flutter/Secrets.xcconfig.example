// Copy to ios/Flutter/Secrets.xcconfig (never committed). Debug.xcconfig and
// Release.xcconfig include it when it exists.

// Your Apple team ID (Xcode > Settings > Accounts). Set once per Mac, so no
// one has to pick the team on every archive.
DEVELOPMENT_TEAM = YOURTEAMID

// API keys read from Info.plist as $(MAPS_API_KEY), for example.
// MAPS_API_KEY = your-key
