#!/bin/sh
# Rebuild the translation code after a branch switch when the ARBs differ,
# so the analyzer never runs on stale lib/core/l10n/generated/ files.
# Args: <old-ref> <new-ref> <is-branch-checkout>
[ "$3" = "1" ] || exit 0
if git diff --quiet "$1" "$2" -- lib/l10n/arb 2>/dev/null; then exit 0; fi
echo "post-checkout: translations changed, running flutter gen-l10n"
flutter gen-l10n >/dev/null 2>&1 || echo "post-checkout: flutter gen-l10n failed; run it by hand"
